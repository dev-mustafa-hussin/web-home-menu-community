<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_home_menu_community.HomeMenu" owl="1">
        <div class="o_home_menu_wrapper" t-on-click="onHomeMenuClick">
            <div class="o_home_menu_header">
                <h2>&#127968; Home Menu</h2>
                <button class="btn" t-on-click="toggleHomeMenu">
                    <t t-if="homeMenuState.isVisible">
                        <i class="fa fa-chevron-up"/> Collapse
                    </t>
                    <t t-else="">
                        <i class="fa fa-chevron-down"/> Expand
                    </t>
                </button>
            </div>
            <div t-if="homeMenuState.isVisible"
                 class="o_home_menu_grid">
                <t t-foreach="homeMenuState.menuItems" t-as="app" t-key="app.id">
                    <div class="o_home_menu_card"
                         t-on-click="(ev) => this.openApp(ev, app)">
                        <div class="o_home_menu_card_icon">
                            <i t-attf-class="fa {{ this.getMenuIcon(app.xmlId) }}"/>
                        </div>
                        <div class="o_home_menu_card_title" t-esc="app.name"/>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
