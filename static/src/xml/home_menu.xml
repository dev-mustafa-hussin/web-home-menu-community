<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="web_home_menu_community.HomeMenu">
        <div t-if="state.menuData.length" class="o_home_menu_wrapper" t-on-click="(ev) => onHomeClick(ev)">
            <div class="o_home_menu_header">
                <h2>Home Menu</h2>
                <button class="btn btn-secondary" t-on-click="(ev) => toggleHome(ev)">
                    <i t-attf-class="fa {{state.isVisible ? 'fa-arrow-up' : 'fa-arrow-down'}}"/>
                    <t t-esc="state.isVisible ? 'Collapse' : 'Expand'"/>
                </button>
            </div>
            <div t-if="state.isVisible" class="o_home_menu_grid">
                <t t-foreach="state.menuData" t-as="menu">
                    <div class="o_home_menu_card" t-on-click="(ev) => onMenuClick(ev, menu)">
                        <div class="o_home_menu_card_icon">
                            <i t-if="menu.xmlId" t-attf-class="fa {{getMenuIcon(menu.xmlId)}}"/>
                            <i t-else="" class="fa fa-folder"/>
                        </div>
                        <div class="o_home_menu_card_title" t-esc="menu.name"/>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
